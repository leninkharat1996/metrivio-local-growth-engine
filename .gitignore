# Generated Google Maps scrape datasets - do not commit lead databases
# by accident. Each run writes to data/google-maps/<run_id>/<search_id>/
# Remove/override these rules explicitly if a specific dataset should be
# kept in git history.
data/google-maps/*
!data/google-maps/.gitkeep

queries.txt

# Python
__pycache__/
*.pyc
.pytest_cache/

# Go build output (upstream scraper checked out at repo root during CI)
/google-maps-scraper/
*.exe

# OS
.DS_Store
