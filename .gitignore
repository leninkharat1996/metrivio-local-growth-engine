# Generated Google Maps scrape datasets - do not commit lead databases
# by accident. Each run writes to data/google-maps/<run_id>/<search_id>/
# Remove/override these rules explicitly if a specific dataset should be
# kept in git history.
data/google-maps/*
!data/google-maps/.gitkeep

# Persistent cross-run master prospect store - generated lead data, never
# committed. See data/master/README.md (tracked) for the schema.
data/master/*
!data/master/.gitkeep

queries.txt

# Generated ICP qualification output - deterministic derived data, never
# committed. Regenerate any time with scripts/icp/qualify.py.
data/icp/*
!data/icp/.gitkeep

# Python
__pycache__/
*.pyc
.pytest_cache/

# Go build output (upstream scraper checked out at repo root during CI)
/google-maps-scraper/
*.exe

# OS
.DS_Store
