# Generated Google Maps scrape datasets - do not commit lead databases
# by accident. Each run writes to data/google-maps/<run_id>/<search_id>/
# Remove/override these rules explicitly if a specific dataset should be
# kept in git history.
data/google-maps/*
!data/google-maps/.gitkeep

# Persistent cross-run master prospect store - generated lead data, never
# committed. See data/master/README.md (tracked) for the schema.
data/master/*
!data/master/.gitkeep

queries.txt

# Generated ICP qualification output - deterministic derived data, never
# committed. Regenerate any time with scripts/icp/qualify.py.
data/icp/*
!data/icp/.gitkeep

# Generated website enrichment output (Step 9) - deterministic derived
# evidence data, never committed. Regenerate any time with
# scripts/enrichment/enrich_websites.py.
data/enrichment/*
!data/enrichment/.gitkeep

# Generated Final ICP qualification output (Step 10) - deterministic
# derived data, never committed. Regenerate any time with
# scripts/final_icp/qualify_final.py.
data/final_icp/*
!data/final_icp/.gitkeep

# Generated production pipeline run outputs (Step 11A) - deterministic
# per-run stats/summary, never committed. Regenerate any time by running
# .github/workflows/production-pipeline.yml.
search_plan.txt
plan.json
icp_stats.json
enrichment_stats.json
final_icp_stats.json
pipeline_summary.json

# Python
__pycache__/
*.pyc
.pytest_cache/

# Go build output (upstream scraper checked out at repo root during CI)
/google-maps-scraper/
*.exe

# OS
.DS_Store
